<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{title}}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script>
  (function () {
    var t = null;
    try { t = localStorage.getItem("theme"); } catch (e) {}
    if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    document.documentElement.setAttribute("data-theme", t);
  })();
</script>
<style>
  :root {
    --bg: #e9eef8; --veil: rgba(236,241,250,.78);
    --glass: rgba(255,255,255,.74); --glass-2: rgba(244,247,253,.8);
    --border: rgba(120,140,180,.28); --hi: rgba(255,255,255,.9);
    --text: #0f1a30; --muted: #566581;
    --brand: #2563eb; --brand-2: #5b9bff; --ring: rgba(37,99,235,.35);
    --bubble: rgba(255,255,255,.95); --ok: #16a34a;
    --shadow: 0 1px 1px rgba(15,26,48,.05), 0 10px 30px rgba(15,26,48,.1), 0 30px 60px -20px rgba(37,99,235,.18);
    --lift: 0 2px 4px rgba(15,26,48,.08), 0 16px 36px rgba(37,99,235,.24);
    --vfilter: none; color-scheme: light;
  }
  [data-theme="dark"] {
    --bg: #070b16; --veil: rgba(7,11,22,.84);
    --glass: rgba(18,26,46,.72); --glass-2: rgba(28,39,68,.7);
    --border: rgba(130,160,220,.2); --hi: rgba(255,255,255,.08);
    --text: #e9eefa; --muted: #93a1c2;
    --brand: #3b82f6; --brand-2: #78acff; --ring: rgba(120,172,255,.45);
    --bubble: rgba(33,46,80,.9); --ok: #4ade80;
    --shadow: 0 1px 1px rgba(0,0,0,.4), 0 12px 32px rgba(0,0,0,.45), 0 30px 60px -20px rgba(59,130,246,.22);
    --lift: 0 2px 4px rgba(0,0,0,.5), 0 16px 38px rgba(59,130,246,.34);
    --vfilter: brightness(.5) saturate(1.15); color-scheme: dark;
  }
  * { box-sizing: border-box; margin: 0; }
  body { min-height: 100vh; font-family: "Manrope", system-ui, -apple-system, "Segoe UI", sans-serif; color: var(--text); background: var(--bg); line-height: 1.5; transition: color .3s; }

  /* Fondo de video + velo para que el texto siempre se lea */
  .bg { position: fixed; inset: 0; z-index: -1; overflow: hidden; background: var(--bg); }
  .bg video { width: 100%; height: 100%; object-fit: cover; filter: var(--vfilter); transition: filter .4s; }
  .bg::after { content: ""; position: absolute; inset: 0; background:
    radial-gradient(900px 480px at 50% -10%, color-mix(in srgb, var(--brand) 22%, transparent), transparent 70%), var(--veil); }

  .app { width: min(780px, 100% - 32px); margin: 0 auto; padding: 22px 0 40px; display: grid; gap: 16px; }
  .glass { background: var(--glass); border: 1px solid var(--border); border-radius: 22px; box-shadow: var(--shadow), inset 0 1px 0 var(--hi);
    backdrop-filter: blur(20px) saturate(1.5); -webkit-backdrop-filter: blur(20px) saturate(1.5); }

  /* Barra superior */
  .top { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 14px 12px 16px; border-radius: 20px; }
  .brand { display: flex; align-items: center; gap: 12px; }
  .logo { width: 42px; height: 42px; border-radius: 13px; display: grid; place-items: center; color: #fff;
    background: linear-gradient(135deg, var(--brand-2), var(--brand)); box-shadow: 0 8px 18px var(--ring), inset 0 1px 0 rgba(255,255,255,.35); }
  .brand h1 { font-size: 1.1rem; font-weight: 800; letter-spacing: -.02em; line-height: 1.2; }
  .live { font-size: .78rem; color: var(--muted); display: flex; align-items: center; gap: 6px; }
  .live::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--ok); animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 55%, transparent); } 100% { box-shadow: 0 0 0 9px transparent; } }
  .icon-btn { width: 42px; height: 42px; border-radius: 13px; border: 1px solid var(--border); background: var(--glass-2); color: var(--text); cursor: pointer; display: grid; place-items: center; transition: transform .2s, box-shadow .2s, border-color .2s; }
  .icon-btn:hover { transform: translateY(-2px) rotate(-8deg); border-color: var(--brand); box-shadow: var(--lift); }
  .icon-btn svg { width: 20px; height: 20px; }
  .sun { display: none; } [data-theme="dark"] .sun { display: block; } [data-theme="dark"] .moon { display: none; }

  /* Publicidad rotativa */
  .ad { position: relative; display: grid; overflow: hidden; border-radius: 22px; color: #fff; box-shadow: var(--shadow); transition: transform .25s, box-shadow .25s; }
  .ad:hover { transform: translateY(-3px); box-shadow: var(--lift); }
  .slide { grid-area: 1 / 1; position: relative; display: flex; align-items: center; gap: 16px; padding: 22px 24px 30px; opacity: 0; visibility: hidden; transition: opacity .6s, visibility .6s; overflow: hidden; }
  .slide.active { opacity: 1; visibility: visible; }
  .tone-0 { background: linear-gradient(120deg, #1e40af, #3b82f6 60%, #7cb4ff); }
  .tone-1 { background: linear-gradient(120deg, #0f5e63, #12a3a0 60%, #5eead4); }
  .tone-2 { background: linear-gradient(120deg, #4c1d95, #7c3aed 60%, #b79bff); }
  .slide::before { content: ""; position: absolute; inset: 0; background: radial-gradient(300px 140px at 90% 0%, rgba(255,255,255,.3), transparent 70%); }
  .big { position: absolute; right: 18px; bottom: -34px; font-size: 9rem; font-weight: 800; line-height: 1; opacity: .13; }
  .mono { position: relative; flex: none; width: 54px; height: 54px; border-radius: 16px; display: grid; place-items: center; font-weight: 800; font-size: 1.4rem;
    background: rgba(255,255,255,.2); border: 1px solid rgba(255,255,255,.35); backdrop-filter: blur(6px); }
  .copy { position: relative; }
  .tag { font-size: .7rem; font-weight: 700; background: rgba(0,0,0,.22); padding: 2px 9px; border-radius: 99px; }
  .copy b { font-size: .85rem; margin-left: 8px; opacity: .9; }
  .copy h2 { font-size: 1.25rem; font-weight: 800; letter-spacing: -.02em; margin-top: 6px; }
  .copy p { font-size: .9rem; opacity: .92; }
  .dots { position: absolute; left: 24px; bottom: 11px; display: flex; gap: 6px; z-index: 2; }
  .dots button { width: 7px; height: 7px; padding: 0; border: 0; border-radius: 99px; background: rgba(255,255,255,.5); cursor: pointer; transition: width .3s, background .3s; }
  .dots button.on { width: 22px; background: #fff; }

  /* Compositor */
  .composer { padding: 18px; display: grid; gap: 16px; }
  .who { display: flex; align-items: center; gap: 12px; }
  .avatar { flex: none; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-weight: 800; box-shadow: 0 0 0 3px var(--glass), 0 0 0 5px var(--ring); }
  .who small { display: block; font-size: .78rem; font-weight: 600; color: var(--muted); }
  .who strong { font-size: 1.1rem; font-weight: 800; letter-spacing: -.01em; }
  .field > label { display: block; font-size: .82rem; font-weight: 700; color: var(--muted); margin-bottom: 6px; }
  .row { display: flex; gap: 10px; }
  .control { flex: 1; display: flex; align-items: center; padding: 0 16px; height: 52px; background: var(--glass-2); border: 1.5px solid var(--border); border-radius: 15px;
    transition: border-color .2s, box-shadow .2s, transform .2s, background-color .2s; }
  .control:hover { border-color: color-mix(in srgb, var(--brand) 55%, var(--border)); transform: translateY(-1px); }
  .control:focus-within { border-color: var(--brand); box-shadow: 0 0 0 4px var(--ring), 0 8px 24px var(--ring); }
  .control input { width: 100%; border: 0; outline: 0; background: transparent; font: inherit; font-size: 1rem; color: var(--text); }
  .control input::placeholder { color: var(--muted); opacity: .85; }
  .shake { animation: shake .35s; border-color: #ef4444; }
  @keyframes shake { 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }
  .send { height: 52px; padding: 0 24px; border: 0; border-radius: 15px; cursor: pointer; font: inherit; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 8px;
    background: linear-gradient(135deg, var(--brand-2), var(--brand)); box-shadow: 0 8px 20px var(--ring), inset 0 1px 0 rgba(255,255,255,.35); transition: transform .2s, box-shadow .2s, filter .2s, opacity .2s; }
  .send svg { width: 18px; height: 18px; transition: transform .25s; }
  .send:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 12px 28px var(--ring), inset 0 1px 0 rgba(255,255,255,.35); filter: brightness(1.07); }
  .send:hover:not(:disabled) svg { transform: translate(3px, -3px); }
  .send:active:not(:disabled) { transform: scale(.96); }
  .send:disabled { opacity: .45; cursor: not-allowed; box-shadow: none; }

  /* Conversación */
  .head { display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; border-bottom: 1px solid var(--border); }
  .head h3 { font-size: 1rem; font-weight: 800; }
  .count { font-size: .78rem; font-weight: 700; color: var(--brand); background: color-mix(in srgb, var(--brand) 15%, transparent); padding: 3px 11px; border-radius: 99px; }
  .messages { height: 400px; overflow-y: auto; padding: 18px; display: flex; flex-direction: column; gap: 14px; scroll-behavior: smooth; }
  .messages::-webkit-scrollbar { width: 8px; } .messages::-webkit-scrollbar-thumb { background: var(--border); border-radius: 8px; }
  .sys { align-self: center; font-size: .76rem; font-weight: 600; color: var(--muted); background: var(--glass-2); border: 1px solid var(--border); padding: 4px 14px; border-radius: 99px; }

  .msg { display: flex; gap: 10px; align-items: flex-end; max-width: 82%; animation: pop .3s ease-out; }
  .msg.mine { align-self: flex-end; flex-direction: row-reverse; }
  .msg .avatar { width: 34px; height: 34px; font-size: .85rem; box-shadow: none; }
  .meta { display: flex; gap: 8px; align-items: baseline; margin: 0 6px 3px; font-size: .78rem; }
  .mine .meta { justify-content: flex-end; }
  .meta b { font-weight: 700; } .meta time { color: var(--muted); font-variant-numeric: tabular-nums; }
  .bubble { padding: 10px 15px; border-radius: 18px 18px 18px 5px; background: var(--bubble); border: 1px solid var(--border); overflow-wrap: anywhere;
    box-shadow: 0 2px 8px rgba(0,0,0,.08); transition: transform .2s, box-shadow .2s, border-color .2s; }
  .mine .bubble { border-radius: 18px 18px 5px 18px; color: #fff; border-color: transparent; background: linear-gradient(135deg, var(--brand-2), var(--brand)); }
  .msg:hover .bubble { transform: translateY(-2px); box-shadow: var(--lift); border-color: color-mix(in srgb, var(--brand) 50%, var(--border)); }
  .mine:hover .bubble { border-color: transparent; }
  .sent { display: flex; justify-content: flex-end; align-items: center; gap: 4px; margin: 3px 6px 0; font-size: .72rem; color: var(--muted); }
  .sent svg { width: 14px; height: 14px; color: var(--ok); }
  @keyframes pop { from { opacity: 0; transform: translateY(12px) scale(.97); } to { opacity: 1; transform: none; } }

  :focus-visible { outline: 3px solid var(--ring); outline-offset: 2px; }
  @media (max-width: 540px) { .send span { display: none; } .send { padding: 0 17px; } .slide { padding-right: 16px; } .big { display: none; } .messages { height: 330px; } .msg { max-width: 92%; } }
  @media (prefers-reduced-motion: reduce) { .bg video { display: none; } * { animation: none !important; transition: none !important; scroll-behavior: auto !important; } }
</style>
</head>
<body>
<div class="bg" aria-hidden="true">
  <video autoplay muted loop playsinline preload="auto" src="/videos/fondochat.mp4"></video>
</div>

{{{body}}}
</body>
</html>
